# Copy to `.env` for local runs. Never commit real keys.

# --- Google AI Studio / Gemini (primary) ---
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default in app is gemma-4-31b-it (hosted Gemma 4 on the same generateContent API).
# Other examples: gemini-2.5-flash-lite, gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemma-4-31b-it

# Optional: AI Studio / Gemma limits — see README. Uncomment to match e.g. 15 RPM + 1500 RPD eval quota.
# GEMINI_RPM=15
# Or an explicit gap in seconds (overrides GEMINI_RPM when both are set):
# GEMINI_MIN_REQUEST_INTERVAL_S=4
# Eval log generator: auto batch = max(ceil(slots/rpd), min(batch_max, slots)) to minimize calls without huge prompts.
# EVAL_GEMINI_RPD_BUDGET=1500
# EVAL_EXPLAIN_BATCH_MAX=20
# Optional: when RPD is off, force a smaller batch (default is min(BATCH_MAX, slots)).
# EVAL_EXPLAIN_BATCH_SIZE_FALLBACK=8

# Optional numeric project id (e.g. projects/495129722569 -> use 495129722569)
GOOGLE_CLOUD_PROJECT=

# Optional training data path override
# CLAIM_DATA_XLSX=claim_use_case_dataset.xlsx

# --- Optional OpenAI-compatible fallback ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

LOG_LEVEL=INFO
